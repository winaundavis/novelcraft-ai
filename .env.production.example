# Backend-only single-instance Beta example; no real secrets.
# Copy into backend/.env only when absent, or inject via process environment.
# Replace host paths. See docs/PUBLIC_BETA_DEPLOYMENT.md.
# Linux reference: /etc/novelcraft/backend.env via systemd EnvironmentFile.
# Ordinary Python does NOT auto-load that absolute config file.
# Runtime dependencies: backend/requirements-production.lock.txt; tests use
# backend/requirements-dev.txt (which includes the production lock).
ENVIRONMENT=beta
DEBUG=false
CORS_ALLOW_ORIGINS=https://app.example.invalid
ALLOWED_HOSTS=REPLACE_WITH_PUBLIC_HOST
DATA_DIR=/srv/novelcraft-private/data
NOVELCRAFT_DB_PATH=/srv/novelcraft-private/data/novelcraft.db
UPLOAD_DIR=/srv/novelcraft-private/uploads
UPLOAD_MAX_BYTES=10485760
# HTTPS required for secure cookies. Override false only for isolated local HTTP smoke.
AUTH_COOKIE_SECURE=true
# Leave empty when using the database-backed invite tool. A placeholder must
# never be copied into a running environment; production readiness rejects it.
INVITE_TOKENS=
# Use the ID returned by /api/auth/register, not the account name.
ADMIN_USER_IDS=REPLACE_WITH_REGISTERED_USER_ID
# Master key, distinct from provider API keys. Keep stable across releases and
# back up separately. Use a private text file readable only by the operator and
# service account; readiness rejects this placeholder.
APP_ENCRYPTION_KEY_FILE=REPLACE_WITH_ABSOLUTE_PRIVATE_KEY_FILE
# Alternative: private environment injection. Use one source, or matching values.
# APP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-v4-flash
DEFAULT_TEMPERATURE=0.8
DEFAULT_MAX_TOKENS=4096
# Inject only the provider credential actually needed. Existing provider keys
# may be retained; local encryption does not revoke historical plaintext copies.
# DEEPSEEK_API_KEY=REPLACE_WITH_PRIVATE_SECRET
# ARTS_API_KEY=REPLACE_WITH_PRIVATE_SECRET
# ARTS_API_BASE=https://gateway.example.invalid/v1
# When using Arts, set DEFAULT_LLM_PROVIDER=arts; verify active DB/role config too.
PROJECT_DAILY_LLM_CALL_LIMIT=30
PROJECT_DAILY_TOKEN_LIMIT=120000
# 非管理员每用户每日「按大纲自动创作」章数上限；改写/审校/续写不占用此额度。
# 必须 >0，生产就绪检查会拒绝 <=0（防止静默关闭产品层额度）。管理员不受限。
USER_DAILY_CHAPTER_LIMIT=10
# 灰度开关：false = 小范围测试期整体放开该额度（非管理员也不受限），
# true = 正式上线恢复限制。关闭时上面的数字保持不变，上线只改这一行。
USER_DAILY_CHAPTER_LIMIT_ENABLED=true
RATE_LIMIT=30
FULLTEXT_MAX_CHARS=600000
LOG_LEVEL=INFO
HEALTH_PATH=/api/health
# Frontend build env separately: VITE_API_BASE_URL=/api, VITE_BETA_AUTH_REQUIRED=true
# Uvicorn port is a CLI --port option; NOVELCRAFT_PORT is not a Settings field.
