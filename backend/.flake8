[flake8]
# 后端静态检查门禁（2026-10-22 引入）。
#
# 只开「写了就一定错、且当前全绿」的规则：
#   E9  —— 语法/运行时错误（E901 语法错、E902 IO 错、E999……）
#   F63 —— 断言恒为假等字符串格式化错误
#   F7  —— 语句层的真实错误（F701 break 在循环外、F702 continue 在循环外、F704 yield 在函数外）
#   F811 —— 同作用域重复定义（后者静默覆盖前者）
#   F82x —— 未定义名字（F821）、__all__ 里未定义（F822）、局部变量先用后赋值（F823）
#
# 刻意**未**纳入的内容（需要先清存量再逐步打开，不要一次全开）：
#   F401 未使用导入、E501 行宽、E1/E2/E3 缩进与空白风格、W 类告警
#   以及所有需要类型信息的规则（那属于 mypy 范畴）
select = E9,F63,F7,F811,F821,F822,F823
max-line-length = 120
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    data,
    release-artifacts,
    node_modules
