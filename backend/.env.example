# Backend-only local Beta example. Copy to backend/.env only if absent.
# Never commit actual credentials. See docs/production-startup.md.
ENVIRONMENT=development
DEBUG=true
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost
# Relative paths resolve from the backend process working directory.
DATA_DIR=./data
NOVELCRAFT_DB_PATH=
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760
# Local HTTP=false; HTTPS deployment=true.
AUTH_COOKIE_SECURE=false
# Empty invites reject registration; use the database-backed invite tool for
# controlled registration. Legacy header mappings (if used) are server-only.
INVITE_TOKENS=
# Set actual account IDs after registration; never put the username here.
# This list (or the user's admin flag in the database) decides who may manage the
# server-wide model config AND whether the "Model settings" entry is rendered in
# the UI. Non-admins get 403 from /api/settings/* even if they guess the URL.
# Restart the backend after changing it. Verify with GET /api/auth/permissions.
ADMIN_USER_IDS=
# Required for beta/production once provider credentials are persisted; inject privately.
APP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
DEFAULT_LLM_PROVIDER=deepseek
DEFAULT_LLM_MODEL=deepseek-v4-flash
DEFAULT_TEMPERATURE=0.8
DEFAULT_MAX_TOKENS=4096
# Optional secrets, supplied privately. No LLM call is needed for basic editing.
# DEEPSEEK_API_KEY=REPLACE_WITH_PRIVATE_SECRET
# ARTS_API_KEY=REPLACE_WITH_PRIVATE_SECRET
# ARTS_API_BASE=https://gateway.example.invalid/v1
# To select Arts as environment default, set DEFAULT_LLM_PROVIDER=arts.
# An active database config/role override can take precedence.
PROJECT_DAILY_LLM_CALL_LIMIT=30
PROJECT_DAILY_TOKEN_LIMIT=120000
# Full-book auto-generation can track foreshadow status once per chapter.
# OFF by default: each tracked chapter costs 1 extra LLM call (counted against
# the project daily limits above). Set true to keep the ledger auto-updated.
FORESHADOW_AUTO_TRACK=false
# Per-IP request quota per 60s for non-exempt API requests. A single project
# workspace load issues several reads, so heavy refresh/navigation can consume
# the window; raise this if 429s appear during normal use. Login and register
# use a separate window and are never starved by this quota.
RATE_LIMIT=30
FULLTEXT_MAX_CHARS=600000
HEALTH_PATH=/api/health
LOG_LEVEL=INFO
# VITE_API_BASE_URL=/api belongs to frontend build env, not this dotenv.
